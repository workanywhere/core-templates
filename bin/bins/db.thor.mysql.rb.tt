#!/usr/bin/env ruby

require "thor"

# https://hub.docker.com/_/mysql

class Db < Thor
  include Thor::Actions

  def self.exit_on_failure?
    false
  end

  desc "start", "Starts the db service"
  method_option :publish, type: :boolean, default: false, desc: 'Publish the port'
  def start(capture: false)
    say "Starting db service"

    db_port = ENV.fetch("DB_PORT", 3306)

    say "Starting db service on port #{db_port}"

    sub_command = ["docker run --rm --detach --name <%= app_name %>-db"]
    sub_command << "--env MYSQL_ALLOW_EMPTY_PASSWORD=yes"
    sub_command << "--network <%= app_name %>-bridge-docker-network"
    sub_command << "--volume <%= app_name %>-data-volume:/var/lib/mysql"
    sub_command << "--volume \"$(pwd)/config/production.sql\":\"/production.sql\""
    sub_command << "--publish #{db_port}:3306" # if options[:publish]
    sub_command << "mysql:latest"

    run(sub_command.join(" "), capture: )

    wait_for_db_ready("<%= app_name %>-db")
  end

  desc "stop", "Stops the db service"
  def stop(capture: false)
    say "Stopping db service"
    run("docker stop <%= app_name %>-db", capture: )
  end

  desc "setup", "Sets up the db service"
  def setup(capture: false)
    run("docker network create <%= app_name %>-bridge-docker-network", capture: )
    run("docker volume create <%= app_name %>-data-volume", capture: )
  end

  desc "prepare", "Creates the database and loads the schema"
  def prepare
    setup(capture: true)
    start(capture: true)
    db_user = ENV.fetch("MYSQL_USER", "root")
    run("docker exec -i <%= app_name %>-db bash -c \"mysql -u #{db_user} < production.sql\"", capture: false)
    run("docker exec <%= app_name %>-db bash -c \"mysql -u #{db_user} -e 'SHOW DATABASES;'\"", capture: false)
  end

  desc "teardown", "Stops and removes the db service"
  def teardown
    stop
    run("docker network rm <%= app_name %>-bridge-docker-network", capture: true)
    run("docker volume rm <%= app_name %>-data-volume", capture: true)
  end

  desc "console", "Opens a mysql console"
  def console
    run("docker exec -it <%= app_name %>-db mysql -u root", capture: false)
  end

  private

  # Wait until MySQL is accepting connections, or time out
  def wait_for_db_ready(container_name)
    max_attempts = 10
    say "Waiting for MySQL in '#{container_name}' to be ready..."

    max_attempts.times do |attempt|
      # Try a simple "SELECT 1" to confirm MySQL is alive
      if system("docker exec #{container_name} mysql -u root -e 'SELECT 1' > /dev/null 2>&1")
        say "MySQL is ready!"
        return
      else
        say "Attempt #{attempt + 1}/#{max_attempts}: Not ready yet. Retrying in 2s..."
        sleep 2
      end
    end

    # If we get here, MySQL never responded in time
    say "ERROR: MySQL did not become ready after #{max_attempts} attempts."
    exit(1)  # or raise an error, etc.
  end
end

Db.start(ARGV)
